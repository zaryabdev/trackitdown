{
    "name": "trackitdown",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:cli": "npm run dev --workspace @trackitdown/cli",
        "dev:web": "npm run dev --workspace @trackitdown/web",
        "build:cli": "npm run build --workspace @trackitdown/cli",
        "build:web": "npm run build --workspace @trackitdown/web",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "build": "npm run build --workspaces --if-present"
    },
    "engines": {
        "node": ">=20.9"
    }
}
